<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Python and Qt JIT / dynamic code execution -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for Python C-extensions, ctypes, and memory allocators -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for loading bundled shared libraries (.dylib, .so) from PySide6 and dependencies -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Required for monitoring active application and window titles via AppleEvents / NSWorkspace -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
